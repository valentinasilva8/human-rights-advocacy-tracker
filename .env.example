# Advocacy Trace configuration.
# Copy to .env if you want local overrides. Do not put real secrets in this file.
# The demonstration runs with no credentials.

# SQLite file. Created locally and ignored by git.
ADVOCACY_TRACE_DB=data/demo.sqlite

# Optional later integrations. Leave blank. The app uses manual import until a provider is added.
SEARCH_PROVIDER=
SEARCH_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
